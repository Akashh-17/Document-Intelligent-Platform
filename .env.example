# ---- LLM (Groq — free key at https://console.groq.com/keys) ----
GROQ_API_KEY=gsk_...

# ---- Web search (optional; Tavily preferred, DuckDuckGo keyless fallback) ----
TAVILY_API_KEY=tvly-...

# ---- LangSmith observability + evals (optional) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=document-intelligence-platform
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Models (override defaults if desired) ----
# Heavy = planning + answer synthesis, Fast = routing / judging / rewriting.
# They use separate Groq rate-limit buckets.
MODEL_HEAVY=openai/gpt-oss-120b
MODEL_FAST=openai/gpt-oss-20b
REASONING_EFFORT=medium
LLM_MAX_RETRIES=4

# ---- Embeddings (local via fastembed; no API key) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Storage / retrieval ----
CHROMA_DIR=./chroma_db
SQLITE_PATH=./memory.sqlite
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ---- Hybrid retrieval (dense + BM25 -> RRF -> cross-encoder rerank) ----
# dense | bm25 | hybrid | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank
RETRIEVER_K=4
DENSE_K=20
BM25_K=20
RRF_K=60
RERANK_ENABLED=true
RERANK_TOP_N=10
MIN_RELEVANCE_SCORE=0.55
MIN_RERANK_SCORE=0.50
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---- Multi-agent budget (keeps one question inside Groq free-tier limits) ----
WORKER_MAX_STEPS=3
MAX_REVISIONS=1
EVIDENCE_CHAR_BUDGET=9000
WEB_FALLBACK=true

# ---- Failure handling ----
# Retry a failed model call on the other tier (separate Groq rate-limit bucket).
MODEL_FALLBACK=true
TURN_TIMEOUT_S=180
# No evidence anywhere: false = say so honestly (recommended);
# true = answer from the model's general knowledge with a clear disclaimer.
ANSWER_WITHOUT_EVIDENCE=false
NEAR_MISS_COUNT=3

# ---- Upload limits ----
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
